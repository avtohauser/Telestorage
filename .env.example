# Домен, на который смотрит A-запись вашего сервера (без https://)
DOMAIN=storage.example.com
# Тот же адрес с https:// — откроется как Mini App
PUBLIC_URL=https://storage.example.com

# Токен бота от @BotFather
BOT_TOKEN=123456789:AA...
# api_id и api_hash с https://my.telegram.org -> API development tools
API_ID=1234567
API_HASH=0123456789abcdef0123456789abcdef

# ID приватного канала-хранилища (бот должен быть в нём админом).
# Не знаете ID? Запустите без него, напишите /id в канале — бот ответит.
STORAGE_CHANNEL_ID=-1001234567890

# Кому разрешён доступ (Telegram user ID через запятую). Пусто — всем.
# Свой ID бот покажет, если написать ему, когда вы не в списке.
ALLOWED_USER_IDS=

# Необязательные настройки
# MAX_FILE_SIZE_MB=20480
# PART_SIZE_MB=1950
# UPLOAD_CONCURRENCY=2
